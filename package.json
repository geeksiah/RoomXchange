{
  "name": "roomxchange",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend",
    "infra/cdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @roomxchange/web",
    "dev:mobile": "npm run dev --workspace @roomxchange/mobile",
    "dev:backend": "npm run dev --workspace @roomxchange/backend",
    "postinstall": "node ./scripts/fix-expo-metro-windows.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cdk:synth": "npm run synth --workspace @roomxchange/cdk",
    "cdk:deploy": "npm run deploy --workspace @roomxchange/cdk"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.9",
    "@types/node": "^22.10.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
