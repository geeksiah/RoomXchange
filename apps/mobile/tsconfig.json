{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "customConditions": ["react-native"],
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "lib": ["DOM", "ESNext"],
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
